# --- Database ---
# Ships with SQLite (Node's built-in node:sqlite module — no native
# compilation, no external DB server) so the MVP runs with zero setup.
# Requires Node 22.5+. Production uses TiDB/MySQL whenever DATABASE_URL is a
# PostgreSQL DDL and point this at a real instance, e.g.:
# DATABASE_URL="postgresql://user:password@localhost:5432/adaptive_fit"
# Set PGSSL=disable only for a local PostgreSQL server without TLS.
PG_POOL_MAX=10
PGSSL="require"
DATABASE_URL="file:./dev.db"

# --- Auth ---
JWT_ACCESS_SECRET="change_me_access_secret"
JWT_REFRESH_SECRET="change_me_refresh_secret"
OTP_HASH_SECRET="change_me_random_32_byte_secret"

# Shared, atomic production OTP rate-limit storage (Upstash Redis REST)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Transactional email (Resend HTTPS API)
RESEND_API_KEY=""
EMAIL_FROM="FitOS <no-reply@example.com>"
EMAIL_REQUIRE_MX=false

# --- Google login (optional) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- AI provider abstraction ---
# Leave unset to use the built-in template provider (no external calls, no
# key required). Set to "anthropic" or "openai" once you implement the
# corresponding class in src/ai/provider.ts.
AI_PROVIDER="template"
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# --- Maps / places provider abstraction ---
# Leave unset to use the mock provider, which returns an honest empty result
# instead of inventing restaurant data. Set to "google_places" once you
# implement GooglePlacesProvider in src/maps/provider.ts.
MAPS_PROVIDER="mock"
GOOGLE_PLACES_API_KEY=""

# --- Equipment vision (local YOLO by default; optional Roboflow SAM3 below) ---
# Put a trained best.pt or exported best.onnx in backend/models, or set the
# absolute path below. The backend starts one persistent Python/Ultralytics
# worker unless ROBOFLOW_WORKFLOW_MODE=true.
EQUIPMENT_MODE="SCANNED"
EQUIPMENT_VISION_MODEL_PATH=""
EQUIPMENT_VISION_PYTHON="python3"
EQUIPMENT_DETECTION_CONFIDENCE_THRESHOLD="0.50"
# Optional Roboflow SAM3 Workflow. Enable explicitly; when enabled, FitOS
# does not silently fall back to the local detector if the API key is missing.
ROBOFLOW_WORKFLOW_MODE="false"
ROBOFLOW_API_KEY=""

PORT=4000
FRONTEND_ORIGIN="http://localhost:5173"

# --- Grow Your Impact monthly calendar ---
# Gujarat, India is the initial holiday calendar. Configure other regions and
# future official holiday years with JSON maps documented in the root README.
GROW_IMPACT_DEFAULT_LOCATION="IN-GJ"
GROW_IMPACT_LOCATION_CALENDARS_JSON=""
GROW_IMPACT_GYM_CLOSURES_JSON=""
# Optional JSON array of exactly three tree options (id, name, species, image, description).
GROW_IMPACT_TREE_OPTIONS=""
