# --- Database ---
# Ships with SQLite (Node's built-in node:sqlite module — no native
# compilation, no external DB server) so the MVP runs with zero setup.
# Requires Node 22.5+. Production uses TiDB/MySQL whenever DATABASE_URL is a
# PostgreSQL DDL and point this at a real instance, e.g.:
# DATABASE_URL="postgresql://user:password@localhost:5432/adaptive_fit"
# Set PGSSL=disable only for a local PostgreSQL server without TLS.
PG_POOL_MAX=10
PGSSL="require"
DATABASE_URL="file:./dev.db"

# --- Auth ---
JWT_ACCESS_SECRET="change_me_access_secret"
JWT_REFRESH_SECRET="change_me_refresh_secret"
OTP_HASH_SECRET="change_me_random_32_byte_secret"

# Shared, atomic production OTP rate-limit storage (Upstash Redis REST)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Transactional email (Resend HTTPS API)
RESEND_API_KEY=""
EMAIL_FROM="FitOS <no-reply@example.com>"
EMAIL_REQUIRE_MX=false

# --- Google login (optional) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Food search providers (optional) ---
# Spoonacular is preferred when configured; keep keys server-side only.
SPOONACULAR_API_KEY=""
SPOONACULAR_TIMEOUT_MS=10000
BONHAPPETEE_RAPIDAPI_KEY=""
BONHAPPETEE_TIMEOUT_MS=10000

# --- AI provider abstraction ---
# Leave unset to use the built-in template provider (no external calls, no
# key required). Set to "anthropic" or "openai" once you implement the
# corresponding class in src/ai/provider.ts.
AI_PROVIDER="template"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-6"
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openrouter/auto"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# --- Maps / places provider abstraction ---
# Leave unset to use the mock provider, which returns an honest empty result
# instead of inventing restaurant data. Set to "google_places" once you
# implement GooglePlacesProvider in src/maps/provider.ts.
MAPS_PROVIDER="mock"
GOOGLE_PLACES_API_KEY=""

# --- Equipment vision (local YOLO by default; optional Roboflow SAM3 below) ---
# Put a trained best.pt or exported best.onnx in backend/models, or set the
# absolute path below. The backend starts one persistent Python/Ultralytics
# worker unless ROBOFLOW_WORKFLOW_MODE=true.
EQUIPMENT_MODE="SCANNED"
EQUIPMENT_VISION_MODEL_PATH=""
EQUIPMENT_VISION_PYTHON="python3"
EQUIPMENT_DETECTION_CONFIDENCE_THRESHOLD="0.50"
# Optional Roboflow workflows. The gym-equipment Workflow flag takes precedence
# over the existing SAM3 workflow flag and uses the saved YOLOv8n workflow.
# It receives sampled webcam frames through POST /equipment/detect.
ROBOFLOW_GYM_EQUIPMENT_WORKFLOW_MODE="false"
# Existing SAM3 Workflow mode (kept separate for compatibility).
ROBOFLOW_WORKFLOW_MODE="false"
ROBOFLOW_API_KEY=""

# Separate image-only people-counting workflow client (does not change equipment detection).
# Uses the published workflow at het-mehta/people-counting-vpeople-counting-nxg8y-k3wzi-1-rfdetr-small-t1-logic.
# Keep the key server-side; the client sends it using Authorization: Bearer.

# --- Exercise demonstration videos ---
# The backend searches for an inline demonstration video for every exercise and
# returns only a video id + embed URL to the client (the key never leaves the
# server). Leave YOUTUBE_API_KEY unset to fall back to the built-in verified
# catalogue of official demonstration videos (no external calls, no key needed).
YOUTUBE_API_KEY=""
# How long a resolved video is cached before it is searched again (hours).
EXERCISE_VIDEO_CACHE_TTL_HOURS=24
# How long "no playable video found" is remembered before retrying (minutes).
EXERCISE_VIDEO_NEGATIVE_TTL_MINUTES=30
# Max YouTube search results inspected per exercise (1-10).
EXERCISE_VIDEO_SEARCH_MAX_RESULTS=5
# Per-request timeout for YouTube Data API calls (milliseconds).
EXERCISE_VIDEO_SEARCH_TIMEOUT_MS=4000

# --- Exercise form comparison (optional Vision Coach enhancement) ---
# Reference-based pose comparison service. Requests are proxied through this
# backend so FITOS_API_KEY never reaches the browser. The comparison feature is
# optional: when these are unset (or the service is down) the Vision Coach keeps
# its camera, rep counting, and basic form feedback and simply hides the
# comparison panel.
FITOS_COMPARISON_API_URL="https://fitos-comparison-api.onrender.com"
FITOS_API_KEY=""
# Per-request timeout for comparison calls (milliseconds, capped at 20000).
FITOS_COMPARISON_TIMEOUT_MS=8000

PORT=4000
FRONTEND_ORIGIN="http://localhost:5173"

# --- Grow Your Impact monthly calendar ---
# Gujarat, India is the initial holiday calendar. Configure other regions and
# future official holiday years with JSON maps documented in the root README.
GROW_IMPACT_DEFAULT_LOCATION="IN-GJ"
GROW_IMPACT_LOCATION_CALENDARS_JSON=""
GROW_IMPACT_GYM_CLOSURES_JSON=""
# Optional JSON array of exactly three tree options (id, name, species, image, description).
GROW_IMPACT_TREE_OPTIONS=""

# --- Vision Coach AI fallback (optional) ---
# Used ONLY for exercises that have no built-in on-device form rules. Squat,
# Curl, Push-up, Bent Over Row and Seated Cable Row never need it. When unset,
# /coach/status reports "not_configured" and the app uploads no camera frames.
GEMINI_API_KEY=""
GEMINI_COACH_MODEL="gemini-2.5-flash"
