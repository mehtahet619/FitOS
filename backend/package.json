{
  "name": "adaptive-fit-backend",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint \"src/**/*.ts\" --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "secretlint": "secretlint \"src/**/*.ts\" \"../frontend/**/*.js\"",
    "danger": "danger ci",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "start": "node dist/server.js",
    "migrate": "ts-node src/db/migrate.ts",
    "migrate:postgres": "ts-node src/db/migrate-postgres.ts",
    "migrate:postgres:prod": "node dist/db/migrate-postgres.js",
    "migrate:mysql": "ts-node src/db/migrate-mysql.ts",
    "migrate:mysql:prod": "node dist/db/migrate-mysql.js",
    "seed": "ts-node src/db/seed.ts",
    "seed:prod": "node dist/db/seed.js",
    "seed:owner": "node dist/db/seed-owner.js",
    "import:exercises": "ts-node scripts/import-exercises.ts",
    "seed:equipment-aliases": "ts-node scripts/seed-equipment-aliases.ts",
    "vision:eval": "ts-node scripts/evaluate-equipment-vision.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@types/uuid": "^10.0.0",
    "@upstash/redis": "^1.39.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "disposable-email-domains-js": "^1.26.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.4.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.0",
    "node-fetch": "^2.7.0",
    "pg": "^8.23.0",
    "resend": "^6.31.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsdom": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.15",
    "@types/pg": "^8.23.1",
    "@types/pngjs": "^6.0.5",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "bwip-js": "^4.11.4",
    "danger": "^14.0.7",
    "eslint": "^10.10.0",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "jsdom": "^25.0.1",
    "pngjs": "^7.0.0",
    "secretlint": "^13.0.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5",
    "@zxing/library": "^0.21.3"
  }
}
